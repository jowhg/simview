{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is built for devices (%@), not for the Simulator. Build it for a simulator destination instead." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is built for devices (%2$@), not for the Simulator. Build it for a simulator destination instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est compilé pour les appareils (%2$@), pas pour le simulateur. Compile-le pour une destination simulateur."
          }
        }
      }
    },
    "%@ was installed but couldn't be opened: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was installed but couldn't be opened: %2$@"
